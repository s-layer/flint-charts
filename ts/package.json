{
  "name": "@s-layer/flint-charts",
  "version": "0.0.0",
  "description": "Semantic-layer-aware Flint charts for agent chat UIs",
  "license": "MIT",
  "author": "Anentropic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-layer/flint-charts.git",
    "directory": "ts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "flint-chart": "1.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
