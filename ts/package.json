{
  "name": "@s-layer/flint-charts",
  "version": "0.1.0",
  "description": "Semantic-layer-aware Flint charts for agent chat UIs",
  "keywords": [
    "flint",
    "charts",
    "semantic-layer",
    "copilotkit",
    "assistant-ui",
    "ag-ui",
    "react"
  ],
  "license": "MIT",
  "author": "Anentropic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-layer/flint-charts.git",
    "directory": "ts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./copilotkit": {
      "types": "./dist/copilotkit.d.ts",
      "import": "./dist/copilotkit.js"
    },
    "./assistant-ui": {
      "types": "./dist/assistant-ui.d.ts",
      "import": "./dist/assistant-ui.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "flint-chart": "1.1.0"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.0",
    "@copilotkit/react-core": "^1.80.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react": {
      "optional": true
    },
    "@copilotkit/react-core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.36",
    "@biomejs/biome": "^2.6.3",
    "@copilotkit/react-core": "1.87.1",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
