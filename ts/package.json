{
  "name": "@s-layer/flint-charts",
  "version": "0.1.0",
  "description": "Semantic-layer-aware Flint charts for agent chat UIs",
  "keywords": [
    "flint",
    "charts",
    "semantic-layer",
    "copilotkit",
    "assistant-ui",
    "ag-ui",
    "react"
  ],
  "license": "MIT",
  "author": "Anentropic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-layer/flint-charts.git",
    "directory": "ts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./copilotkit": {
      "types": "./dist/copilotkit.d.ts",
      "import": "./dist/copilotkit.js"
    },
    "./assistant-ui": {
      "types": "./dist/assistant-ui.d.ts",
      "import": "./dist/assistant-ui.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "flint-chart": "~1.0.1"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.0",
    "@copilotkit/react-core": "^1.80.0",
    "react": ">=18",
    "vega": "^5.0.0 || ^6.0.0",
    "vega-lite": "^5.0.0 || ^6.0.0",
    "vega-tooltip": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react": {
      "optional": true
    },
    "@copilotkit/react-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vega": {
      "optional": true
    },
    "vega-lite": {
      "optional": true
    },
    "vega-tooltip": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.31",
    "@biomejs/biome": "^2.6.3",
    "@copilotkit/react-core": "1.80.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "flint-chart-mcp": "1.0.1",
    "happy-dom": "^21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vega": "6.4.0",
    "vega-lite": "6.5.0",
    "vega-tooltip": "1.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
